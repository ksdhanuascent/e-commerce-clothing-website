:{$id:"urn:dm:schemas:controllers.json",ControllerList:{allOf:[{$ref:"urn:dm:schemas:common.json#/DataNode--unrestricted-root"},{type:"object",properties:{controllers:{default:[],type:["array"],items:[{type:["null","string"]}]}}}],unevaluatedProperties:!1,type:"object"},"ControllerList--unrestricted-root":{allOf:[{$ref:"urn:dm:schemas:common.json#/DataNode--unrestricted-root"},{type:"object",properties:{controllers:{default:[],type:["array"],items:[{type:["null","string"]}]}}}],type:"object"}},"css-value-definitions.schema.json":{$id:"urn:dm:schemas:css-value-definitions.schema.json",title:"CSS Value Definitions",description:"Individual JSON Schema definitions for CSS value types, suitable for format registration",definitions:{"<positive-value>":{type:"string",pattern:"^[^-]",description:"CSS positive value"},"<length>":{oneOf:[{$ref:"#/definitions/<basic-math-functions-without-percentage>"},{type:"string",pattern:"^(0|(-?\\d*\\.?\\d+(px|spx|em|ex|ch|rem|lh|rlh|vw|vh|vmin|vmax|cm|mm|in|pt|pc|q)))$"}],description:"CSS numeric length with all valid units"},"<positive-length>":{allOf:[{$ref:"#/definitions/<positive-value>"},{$ref:"#/definitions/<length>"}],description:"CSS positive numeric length with all valid units"},"<percentage>":{oneOf:[{$ref:"#/definitions/<basic-math-functions>"},{type:"string",pattern:"^-?\\d*\\.?\\d+%$"}],description:"Number followed by %"},"<positive-percentage>":{allOf:[{$ref:"#/definitions/<positive-value>"},{$ref:"#/definitions/<percentage>"}],description:"Positive number followed by %"},"<length-percentage>":{anyOf:[{$ref:"#/definitions/<length>"},{$ref:"#/definitions/<percentage>"}],description:"Accepts both <length> and <percentage>"},"<positive-length-percentage>":{anyOf:[{$ref:"#/definitions/<positive-length>"},{$ref:"#/definitions/<positive-percentage>"}],description:"Accepts both <positive-length> and <positive-percentage>"},"<auto>":{type:"string",enum:["auto"],description:"CSS auto keyword"},"<length-percentage-auto>":{anyOf:[{$ref:"#/definitions/<length>"},{$ref:"#/definitions/<percentage>"},{$ref:"#/definitions/<auto>"}],description:"CSS length, percentage, or auto"},"<positive-length-percentage-auto>":{anyOf:[{$ref:"#/definitions/<positive-length>"},{$ref:"#/definitions/<positive-percentage>"},{$ref:"#/definitions/<auto>"}],description:"CSS positive length, positive percentage, or auto"},"<number>":{oneOf:[{$ref:"#/definitions/<all-math-functions-without-percentage>"},{type:"string",pattern:"^-?\\d*\\.?\\d+$"}],description:"Decimal or integer number"},"<positive-number>":{allOf:[{$ref:"#/definitions/<positive-value>"},{$ref:"#/definitions/<number>"}],description:"Positive decimal or integer number"},"<integer>":{oneOf:[{$ref:"#/definitions/<all-math-functions-without-percentage>"},{type:"string",pattern:"^-?\\d+$"}],description:"Whole numbers only"},height:{anyOf:[{$ref:"#/definitions/<auto>"},{$ref:"#/definitions/<positive-length-percentage>"},{type:"string",enum:["min-content","max-content"]}],description:"CSS height value"},"<angle>":{oneOf:[{$ref:"#/definitions/<all-math-functions>"},{type:"string",pattern:"^-?\\d*\\.?\\d+(deg|rad|grad|turn)$"}],description:"Used in rotation, direction, etc."},"<time>":{oneOf:[{$ref:"#/definitions/<basic-math-functions-without-percentage>"},{type:"string",pattern:"^-?\\d*\\.?\\d+(ms|s)$"}],description:"CSS durations (s, ms)"},"<resolution>":{type:"string",pattern:"^-?\\d*\\.?\\d+(dpi|dpcm|dppx|x)$",description:"Screen density/resolution units"},"<frequency>":{oneOf:[{$ref:"#/definitions/<basic-math-functions>"},{type:"string",pattern:"^-?\\d*\\.?\\d+(Hz|kHz)$"}],description:"Used in aural CSS or media queries"},"<dimension>":{type:"string",pattern:"^-?\\d*\\.?\\d+[a-zA-Z]+$",description:"Generic dimension (unit required)"},"<percentage-or-number>":{oneOf:[{$ref:"#/definitions/<number>"},{$ref:"#/definitions/<percentage>"}],description:"Matches numbers or percentages"},"<custom-ident>":{type:"string",pattern:"^[a-zA-Z_][\\w-]*$",description:"CSS identifiers (excluding keywords)"},"<ident>":{type:"string",pattern:"^[a-zA-Z_][\\w-]*$",description:"Same as <custom-ident>"},"<string>":{type:"string",pattern:`^"(?:[^"\\\\]|\\\\.)*"|'(?:[^'\\\\]|\\\\.)*'$`,description:"Quoted strings with escapes"},"<url>":{type:"string",pattern:`^url\\((['"]?).*?\\1\\)$`,description:"Matches url(...) with optional quotes"},"<hex-color>":{type:"string",pattern:"^#([a-fA-F0-9]{3}|[a-fA-F0-9]{4}|[a-fA-F0-9]{6}|[a-fA-F0-9]{8})$",description:"Hexadecimal color values: #rgb, #rgba, #rrggbb, #rrggbbaa"},"<rgb-color>":{type:"string",pattern:"^rgba?\\(\\s*\\d+\\s*,\\s*\\d+\\s*,\\s*\\d+(\\s*,\\s*\\d*(\\.\\d+)?)?\\s*\\)$",description:"RGB/RGBA functional notation. Note: This regex cannot fully validate percentage values or modern space-separated syntax."},"<hsl-color>":{type:"string",pattern:"^hsla?\\(\\s*\\d+\\s*,\\s*\\d+%\\s*,\\s*\\d+%(\\s*,\\s*\\d*(\\.\\d+)?)?\\s*\\)$",description:"HSL/HSLA functional notation. Note: This regex cannot fully validate modern space-separated syntax or angle units for hue."},"<named-color>":{type:"string",enum:["transparent","currentColor","aliceblue","antiquewhite","aqua","aquamarine","azure","beige","bisque","black","blanchedalmond","blue","blueviolet","brown","burlywood","cadetblue","chartreuse","chocolate","coral","cornflowerblue","cornsilk","crimson","cyan","darkblue","darkcyan","darkgoldenrod","darkgray","darkgrey","darkgreen","darkkhaki","darkmagenta","darkolivegreen","darkorange","darkorchid","darkred","darksalmon","darkseagreen","darkslateblue","darkslategray","darkslategrey","darkturquoise","darkviolet","deeppink","deepskyblue","dimgray","dimgrey","dodgerblue","firebrick","floralwhite","forestgreen","fuchsia","gainsboro","ghostwhite","gold","goldenrod","gray","grey","green","greenyellow","honeydew","hotpink","indianred","indigo","ivory","khaki","lavender","lavenderblush","lawngreen","lemonchiffon","lightblue","lightcoral","lightcyan","lightgoldenrodyellow","lightgray","lightgrey","lightgreen","lightpink","lightsalmon","lightseagreen","lightskyblue","lightslategray","lightslategrey","lightsteelblue","lightyellow","lime","limegreen","linen","magenta","maroon","mediumaquamarine","mediumblue","mediumorchid","mediumpurple","mediumseagreen","mediumslateblue","mediumspringgreen","mediumturquoise","mediumvioletred","midnightblue","mintcream","mistyrose","moccasin","navajowhite","navy","oldlace","olive","olivedrab","orange","orangered","orchid","palegoldenrod","palegreen","paleturquoise","palevioletred","papayawhip","peachpuff","peru","pink","plum","powderblue","purple","rebeccapurple","red","rosybrown","royalblue","saddlebrown","salmon","sandybrown","seagreen","seashell","sienna","silver","skyblue","slateblue","slategray","slategrey","snow","springgreen","steelblue","tan","teal","thistle","tomato","turquoise","violet","wheat","white","whitesmoke","yellow","yellowgreen"],description:"CSS named colors including transparent and currentColor"},"<css-value-containing-var()>":{type:"string",pattern:"^(?=.*var\\(\\s*--[^)]).+$",description:"Any CSS value string containing at least one var() reference. Slot-level validation is deferred to runtime (dummy substitution / css-tree)."},"<color>":{anyOf:[{$ref:"#/definitions/<hex-color>"},{$ref:"#/definitions/<rgb-color>"},{$ref:"#/definitions/<hsl-color>"},{$ref:"#/definitions/<named-color>"}],description:"CSS color values supporting hex, rgb/rgba, hsl/hsla, and named colors"},"<image>":{anyOf:[{$ref:"#/definitions/<url>"},{type:"string",pattern:"^(linear-gradient|radial-gradient|conic-gradient|repeating-linear-gradient|repeating-radial-gradient|repeating-conic-gradient)\\(.*\\)$",description:"Gradient functions - arguments cannot be fully validated with regex"},{type:"string",pattern:"^image\\(.*\\)$",description:"Image function - arguments cannot be fully validated with regex"}],description:"CSS image values including URLs, gradients, and image() functions"},"<position>":{anyOf:[{$ref:"#/definitions/<position-one>"},{$ref:"#/definitions/<position-two>"},{$ref:"#/definitions/<position-four>"}],description:"Single position value. Full position syntax with multiple values and combinations requires complex parsing that cannot be fully validated with regex."},"<position-one>":{anyOf:[{enum:["left","center","right","top","bottom","x-start","x-end","y-start","y-end","block-start","block-end","inline-start","inline-end"]},{$ref:"#/definitions/<positive-length-percentage>"}]},"<position-two>":{anyOf:[{pattern:"^(((left|center|right|x-start|x-end)\\s(top|center|bottom|y-start|y-end))|((top|center|bottom|y-start|y-end)\\s(left|center|right|x-start|x-end)))$"},{pattern:"^(0|(calc|min|max|clamp|round|mod|rem|abs)\\(.+\\)|\\d+(\\.\\d+)?(px|spx|em|ex|ch|rem|lh|rlh|vw|vh|vmin|vmax|cm|mm|in|pt|pc|q|%))\\s(0|(calc|min|max|clamp|round|mod|rem|abs)\\(.+\\)|\\d+(\\.\\d+)?(px|spx|em|ex|ch|rem|lh|rlh|vw|vh|vmin|vmax|cm|mm|in|pt|pc|q|%))$"},{pattern:"^((block-start|center|block-end)\\s(inline-start|center|inline-end))|((inline-start|center|inline-end)\\s(block-start|center|block-end))$"},{pattern:"^((start|center|end)\\s*){2}$"}]},"<position-four>":{anyOf:[{pattern:"^((left|right|x-start|x-end)\\s(0|(calc|min|max|clamp|round|mod|rem|abs)\\(.+\\)|\\d+(\\.\\d+)?(px|spx|em|ex|ch|rem|lh|rlh|vw|vh|vmin|vmax|cm|mm|in|pt|pc|q|%))\\s(top|bottom|y-start|y-end)\\s(0|(calc|min|max|clamp|round|mod|rem|abs)\\(.+\\)|\\d+(\\.\\d+)?(px|spx|em|ex|ch|rem|lh|rlh|vw|vh|vmin|vmax|cm|mm|in|pt|pc|q|%)))|((top|bottom|y-start|y-end)\\s(0|(calc|min|max|clamp|round|mod|rem|abs)\\(.+\\)|\\d+(\\.\\d+)?(px|spx|em|ex|ch|rem|lh|rlh|vw|vh|vmin|vmax|cm|mm|in|pt|pc|q|%))\\s(left|right|x-start|x-end)\\s(0|(calc|min|max|clamp|round|mod|rem|abs)\\(.+\\)|\\d+(\\.\\d+)?(px|spx|em|ex|ch|rem|lh|rlh|vw|vh|vmin|vmax|cm|mm|in|pt|pc|q|%)))$"},{pattern:"^((block-start|block-end)\\s(0|(calc|min|max|clamp|round|mod|rem|abs)\\(.+\\)|\\d+(\\.\\d+)?(px|spx|em|ex|ch|rem|lh|rlh|vw|vh|vmin|vmax|cm|mm|in|pt|pc|q|%))\\s(inline-start|inline-end)\\s(0|(calc|min|max|clamp|round|mod|rem|abs)\\(.+\\)|\\d+(\\.\\d+)?(px|spx|em|ex|ch|rem|lh|rlh|vw|vh|vmin|vmax|cm|mm|in|pt|pc|q|%)))|((inline-start|inline-end)\\s(0|(calc|min|max|clamp|round|mod|rem|abs)\\(.+\\)|\\d+(\\.\\d+)?(px|spx|em|ex|ch|rem|lh|rlh|vw|vh|vmin|vmax|cm|mm|in|pt|pc|q|%))\\s(block-start|block-end)\\s(0|(calc|min|max|clamp|round|mod|rem|abs)\\(.+\\)|\\d+(\\.\\d+)?(px|spx|em|ex|ch|rem|lh|rlh|vw|vh|vmin|vmax|cm|mm|in|pt|pc|q|%)))$"},{pattern:"^((start|end)\\s(0|(calc|min|max|clamp|round|mod|rem|abs)\\(.+\\)|\\d+(\\.\\d+)?(px|spx|em|ex|ch|rem|lh|rlh|vw|vh|vmin|vmax|cm|mm|in|pt|pc|q|%))\\s*){2}$"}]},"<transform-function>":{type:"string",pattern:"^(matrix|matrix3d|perspective|rotate|rotate3d|rotateX|rotateY|rotateZ|scale|scale3d|scaleX|scaleY|scaleZ|skew|skewX|skewY|translate|translate3d|translateX|translateY|translateZ)\\(.*\\)$",description:"Transform functions like rotate(), translate(), scale(). Function arguments cannot be fully validated with regex as they require parsing of nested expressions."},"<var()>":{type:"string",pattern:"^var\\(--[^(),]+(?:,\\s?.+)?\\)$",description:"CSS var() function- resolving a variable value from the variable"},"<basic-math-functions>":{type:"string",pattern:"^(calc|min|max|clamp|round|mod|rem|abs)\\((?!.*\\/\\s*0\\b).+\\)$",description:"Basic CSS math functions that work with any value type. Percentages allowed where contextually appropriate."},"<basic-math-functions-without-percentage>":{type:"string",pattern:"^(calc|min|max|clamp|round|mod|rem|abs)\\((?!.*\\/\\s*0\\b)[^%]+\\)$",description:"Basic CSS math functions without percentages or division by zero."},"<basic-math-functions-with-percentage>":{type:"string",pattern:"(calc|min|max|clamp|round|mod|rem|abs)\\([^)]*%[^)]*\\)",description:"Detects if any basic math function contains percentages"},"<all-math-functions>":{type:"string",pattern:"^(calc|min|max|clamp|round|mod|rem|abs|sin|cos|tan|asin|acos|atan|atan2|pow|sqrt|hypot|log|exp|sign)\\((?!.*\\/\\s*0\\b).+\\)$",description:"All CSS math functions - basic, trigonometric, and advanced mathematical functions."},"<all-math-functions-without-percentage>":{type:"string",pattern:"^(calc|min|max|clamp|round|mod|rem|abs|sin|cos|tan|asin|acos|atan|atan2|pow|sqrt|hypot|log|exp|sign)\\((?!.*\\/\\s*0\\b)(?!.*%).+\\)$",description:"All CSS math functions without percentages or division by zero."},"<attr()>":{type:"string",pattern:"^attr\\(.*\\)$",description:"CSS attr() function. Cannot fully validate fallback values and type hints with regex."},"<image-set()>":{type:"string",pattern:"^image-set\\(.*\\)$",description:"CSS image-set() function. Cannot parse comma-separated URLs and resolution descriptors with regex."},"<basic-shape>":{type:"string",pattern:"^(inset|rect|xywh|circle|ellipse|polygon|path|shape)\\(.*\\)$",description:"CSS basic shape functions. Shape-specific arguments cannot be fully validated with regex."},"<filter-function>":{type:"string",pattern:"^(blur|brightness|contrast|drop-shadow|grayscale|hue-rotate|invert|opacity|saturate|sepia|url)\\(([^\\(\\)]*|(\\([^\\(\\)]*\\)))+\\)$",description:"CSS filter functions. Function arguments cannot be fully validated with regex."},"<filter-value-list>":{type:"string",pattern:"^((blur|brightness|contrast|drop-shadow|grayscale|hue-rotate|invert|opacity|saturate|sepia|url)\\(([^\\(\\)]*|(\\([^\\(\\)]*\\)))+\\))(\\s+(blur|brightness|contrast|drop-shadow|grayscale|hue-rotate|invert|opacity|saturate|sepia|url)\\(([^\\(\\)]*|(\\([^\\(\\)]*\\)))+\\))*$",description:"CSS filter functions - value separated list. Function arguments cannot be fully validated with regex."},"<filter>":{anyOf:[{$ref:"#/definitions/<none>"},{$ref:"#/definitions/<filter-value-list>"}],description:"CSS filter value"},"<line-width>":{anyOf:[{$ref:"#/definitions/<positive-length>"},{type:"string",enum:["thin","medium","thick"]}],description:"CSS line width: length values or predefined keywords"},"<line-style>":{type:"string",enum:["none","hidden","dotted","dashed","solid","double","groove","ridge","inset","outset"],description:"CSS line style keywords"},"<global-values>":{type:"string",enum:["inherit","initial","unset","revert","revert-layer"],description:"Global values available for any CSS property"},"<flex>":{type:"string",pattern:"^\\d*\\.?\\d+fr$",description:"CSS flex unit for grid and flexbox"},"<none>":{type:"string",enum:["none"],description:"CSS none keyword"},"<normal>":{type:"string",enum:["normal"],description:"CSS normal keyword"},"<shadow>":{anyOf:[{$ref:"#/definitions/<none>"},{type:"string",pattern:"^(inset\\s+)?(-?\\d+\\w*\\s+){2,4}(#[a-fA-F0-9]{3,8}|rgba?\\(.*\\)|hsla?\\(.*\\)|[a-zA-Z]+)?$"}],description:"CSS shadow value (box-shadow, text-shadow). Complex syntax with optional inset, multiple length values, and color cannot be fully validated with regex."},"<font-family>":{anyOf:[{$ref:"#/definitions/<family-name>"},{$ref:"#/definitions/<generic-family>"},{type:"string",pattern:`^['"]?([^\\d][\\p{L}\\s\\-_\\d]*)['"]?(,\\s*['"]?([^\\d][\\p{L}\\s\\-_\\d]*)['"]?)*$`,description:"Complex family name with multiple family names separated by commas"}],description:"CSS font family: generic families, quoted family names, or unquoted family names"},"<font-weight>":{anyOf:[{type:"string",enum:["normal","bold","bolder","lighter"]},{type:"string",pattern:"^(100|200|300|400|500|600|700|800|900)$"}],description:"CSS font weight: keywords or numeric values"},"<font-style>":{anyOf:[{type:"string",enum:["normal","italic","oblique"]},{type:"string",pattern:"^oblique\\s+\\d+deg$"}],description:"CSS font style: keywords or oblique with angle"},"<font-size>":{anyOf:[{$ref:"#/definitions/<absolute-size>"},{$ref:"#/definitions/<relative-size>"},{$ref:"#/definitions/<positive-length-percentage>"},{type:"string",enum:["math"]}],description:"CSS font size: length, percentage, or keyword values"},"<display>":{anyOf:[{type:"string",enum:["table-row-group","table-header-group","table-footer-group","table-row","table-cell","table-column-group","table-column","table-caption","ruby-base","ruby-text","ruby-base-container","ruby-text-container","contents","none","inline-block","inline-table","inline-flex","inline-grid"]},{type:"string",description:"complex display value that cannot be fully validated with regex"}],description:"CSS display property values"},"<overflow-block>":{type:"string",enum:["visible","hidden","clip","scroll","auto"],description:"CSS overflow-x and overflow-y property values"},"<overflow>":{type:"string",pattern:"^(visible|hidden|scroll|auto|clip)(\\s+(visible|hidden|scroll|auto|clip))?$",description:"CSS overflow property values"},"<text-align>":{type:"string",enum:["left","right","center","justify","start","end","match-parent"],description:"CSS text-align property values"},"<align-items>":{anyOf:[{$ref:"#/definitions/<normal>"},{type:"string",enum:["stretch"]},{$ref:"#/definitions/<baseline-position>"},{type:"string",pattern:"^((safe|unsafe)\\s+)?(center|start|end|self-start|self-end|flex-start|flex-end)$"}],description:"CSS align-items values"},"<vertical-align>":{anyOf:[{type:"string",enum:["baseline","sub","super","text-top","text-bottom","middle","top","bottom"]},{$ref:"#/definitions/<length>"},{$ref:"#/definitions/<percentage>"}],description:"CSS vertical-align: keywords, length, or percentage"},"<border-radius>":{type:"string",pattern:"^(0|(calc|min|max|clamp|round|mod|rem|abs)\\(.+\\)|\\d+(\\.\\d+)?(px|spx|em|ex|ch|rem|lh|rlh|vw|vh|vmin|vmax|cm|mm|in|pt|pc|q|%)\\s*){1,4}(/\\s*(0|(calc|min|max|clamp|round|mod|rem|abs)\\(.+\\)|\\d+(\\.\\d+)?(px|spx|em|ex|ch|rem|lh|rlh|vw|vh|vmin|vmax|cm|mm|in|pt|pc|q|%)\\s*){1,4})?$",description:"CSS border-radius shorthand. Complex syntax combining multiple radius values cannot be fully validated with regex."},"<border-top-left-radius>":{type:"string",pattern:"^(calc|min|max|clamp|round|mod|rem|abs\\([^,]+\\)|\\d*\\.?\\d+(px|spx|em|ex|ch|rem|lh|rlh|vw|vh|vmin|vmax|cm|mm|in|pt|pc|q|%))(\\s+(calc|min|max|clamp|round|mod|rem|abs\\([^,]+\\)|\\d*\\.?\\d+(px|spx|em|ex|ch|rem|lh|rlh|vw|vh|vmin|vmax|cm|mm|in|pt|pc|q|%)))?$",description:"CSS border-top-left-radius shorthand"},"<border-style>":{type:"string",pattern:"^(none|hidden|dotted|dashed|solid|double|groove|ridge|inset|outset)(\\s+(none|hidden|dotted|dashed|solid|double|groove|ridge|inset|outset)){0,3}$",description:"CSS border-style shorthand"},"<border-width>":{type:"string",pattern:"^(thin|medium|thick|(calc|min|max|clamp|round|mod|rem|abs)\\([^,]+\\)|(\\d*\\.?\\d+(px|spx|em|ex|ch|rem|lh|rlh|vw|vh|vmin|vmax|cm|mm|in|pt|pc|q)))(\\s+(thin|medium|thick|(calc|min|max|clamp|round|mod|rem|abs)\\([^,]+\\)|(\\d*\\.?\\d+(px|spx|em|ex|ch|rem|lh|rlh|vw|vh|vmin|vmax|cm|mm|in|pt|pc|q)))){0,3}$",description:"CSS border-width shorthand"},"<border>":{type:"string",pattern:"^(?!.*\\/\\s*0).*$",description:"CSS border shorthand with division by zero rejection in calc expressions. Detailed syntax validation handled by css-tree."},"<background>":{type:"string",description:"CSS background shorthand. Extremely complex syntax combining multiple background layers with image, position, size, repeat, attachment, origin, clip, and color cannot be fully validated with regex."},"<transition>":{type:"string",description:"CSS transition shorthand. Complex syntax combining property, duration, timing-function, and delay cannot be fully validated with regex."},"<animation>":{type:"string",description:"CSS animation shorthand. Complex syntax combining name, duration, timing-function, delay, iteration-count, direction, fill-mode, and play-state cannot be fully validated with regex."},"<grid-template>":{type:"string",description:"CSS grid template properties. Complex syntax with track sizes, line names, and repeat functions cannot be fully validated with regex."},"<flex-shorthand>":{type:"string",description:"CSS flex shorthand combining flex-grow, flex-shrink, and flex-basis. Complex parsing required to validate the various combinations."},"<blend-mode>":{type:"string",enum:["normal","multiply","screen","overlay","darken","lighten","color-dodge","color-burn","hard-light","soft-light","difference","exclusion","hue","saturation","color","luminosity"],description:"CSS blend mode values for mix-blend-mode and background-blend-mode"},"<mix-blend-mode>":{$ref:"#/definitions/<blend-mode>",description:"CSS mix-blend-mode property values"},"<background-blend-mode>":{$ref:"#/definitions/<blend-mode>",description:"CSS background-blend-mode property values"},"<timing-function>":{anyOf:[{type:"string",enum:["ease","ease-in","ease-out","ease-in-out","linear","step-start","step-end"]},{type:"string",pattern:"^cubic-bezier\\(\\s*-?\\d*\\.?\\d+\\s*,\\s*-?\\d*\\.?\\d+\\s*,\\s*-?\\d*\\.?\\d+\\s*,\\s*-?\\d*\\.?\\d+\\s*\\)$"},{type:"string",pattern:"^steps\\(\\s*\\d+\\s*(,\\s*(start|end)\\s*)?\\)$"}],description:"CSS timing function: keywords, cubic-bezier(), or steps()"},"<repeat-style>":{type:"string",enum:["repeat","repeat-x","repeat-y","no-repeat","space","round"],description:"CSS background-repeat values"},"<attachment>":{type:"string",enum:["scroll","fixed","local"],description:"CSS background-attachment values"},"<origin>":{type:"string",enum:["border-box","padding-box","content-box"],description:"CSS background-origin values"},"<clip>":{type:"string",enum:["border-box","padding-box","content-box","text"],description:"CSS background-clip values"},"<sizing>":{anyOf:[{type:"string",enum:["auto","cover","contain"]},{$ref:"#/definitions/<length>"},{$ref:"#/definitions/<percentage>"}],description:"CSS background-size values"},"<cursor>":{anyOf:[{type:"string",enum:["auto","default","none","context-menu","help","pointer","progress","wait","cell","crosshair","text","vertical-text","alias","copy","move","no-drop","not-allowed","grab","grabbing","all-scroll","col-resize","row-resize","n-resize","e-resize","s-resize","w-resize","ne-resize","nw-resize","se-resize","sw-resize","ew-resize","ns-resize","nesw-resize","nwse-resize","zoom-in","zoom-out"]},{$ref:"#/definitions/<url>"}],description:"CSS 