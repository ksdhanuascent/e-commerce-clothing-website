ref:"#/definitions/<angle>"},{$ref:"#/definitions/<percentage>"}],description:"CSS angle or percentage"},"<number-percentage>":{anyOf:[{$ref:"#/definitions/<number>"},{$ref:"#/definitions/<percentage>"}],description:"CSS number or percentage"},"<time-percentage>":{anyOf:[{$ref:"#/definitions/<time>"},{$ref:"#/definitions/<percentage>"}],description:"CSS time or percentage"},"<frequency-percentage>":{anyOf:[{$ref:"#/definitions/<frequency>"},{$ref:"#/definitions/<percentage>"}],description:"CSS frequency or percentage"},"<baseline-position>":{type:"string",pattern:"^(first\\s+baseline|last\\s+baseline|baseline)$",description:"CSS baseline position: baseline, first baseline, or last baseline"},"<content-distribution>":{type:"string",enum:["space-between","space-around","space-evenly","stretch"],description:"CSS content distribution values for alignment"},"<content-position>":{type:"string",enum:["center","start","end","flex-start","flex-end"],description:"CSS content position values for alignment"},"<self-position>":{type:"string",enum:["center","start","end","self-start","self-end","flex-start","flex-end"],description:"CSS self position values for alignment"},"<overflow-position>":{type:"string",enum:["unsafe","safe"],description:"CSS overflow position modifiers"},"<justify-content>":{anyOf:[{$ref:"#/definitions/<normal>"},{$ref:"#/definitions/<content-distribution>"},{$ref:"#/definitions/<content-position>"},{type:"string",enum:["left","right"]},{type:"string",pattern:"^(safe|unsafe)?\\s+(left|right|center|start|end|flex-start|flex-end)$"}],description:"CSS justify-content values"},"<visual-box>":{type:"string",enum:["content-box","padding-box","border-box"],description:"CSS visual box types"},"<shape-box>":{anyOf:[{$ref:"#/definitions/<visual-box>"},{type:"string",enum:["margin-box"]}],description:"CSS shape box types"},"<geometry-box>":{anyOf:[{$ref:"#/definitions/<shape-box>"},{type:"string",enum:["fill-box","stroke-box","view-box"]}],description:"CSS geometry box types including visual box and additional geometry boxes"},"<paint-box>":{anyOf:[{$ref:"#/definitions/<visual-box>"},{type:"string",enum:["fill-box","stroke-box"]}],description:"CSS paint box types"},"<coord-box>":{anyOf:[{$ref:"#/definitions/<paint-box>"},{type:"string",enum:["view-box"]}],description:"CSS coordinate box types (paint-box or view-box)"},"<mask-clip>":{anyOf:[{$ref:"#/definitions/<coord-box>"},{type:"string",enum:["no-clip"]}],description:"CSS mask-clip values including coord-box and no-clip"},"<mask-origin>":{$ref:"#/definitions/<coord-box>",description:"CSS mask-origin values (coord-box)"},"<generic-family>":{type:"string",enum:["serif","sans-serif","monospace","cursive","fantasy","system-ui","ui-serif","ui-sans-serif","ui-monospace","ui-rounded","math","emoji","fangsong"],description:"CSS generic font families"},"<family-name>":{anyOf:[{$ref:"#/definitions/<string>"},{$ref:"#/definitions/<custom-ident>"}],description:"CSS font family name: quoted string or unquoted identifier"},"<system-family-name>":{type:"string",enum:["caption","icon","menu","message-box","small-caption","status-bar"],description:"CSS system font family names"},"<font-stretch-absolute>":{anyOf:[{type:"string",enum:["normal","ultra-condensed","extra-condensed","condensed","semi-condensed","semi-expanded","expanded","extra-expanded","ultra-expanded"]},{$ref:"#/definitions/<percentage>"}],description:"CSS font stretch absolute values"},"<font-weight-absolute>":{anyOf:[{type:"string",enum:["normal","bold"]},{type:"string",pattern:"^(100|200|300|400|500|600|700|800|900|[1-9][0-9]{0,2})$"}],description:"CSS font weight absolute values: normal, bold, or number 1-1000"},"<grid-line>":{type:"string",description:"CSS grid line: auto, custom identifier, integer with optional identifier, or span notation. Complex syntax cannot be fully validated with regex."},"<track-breadth>":{anyOf:[{$ref:"#/definitions/<length-percentage>"},{$ref:"#/definitions/<flex>"},{type:"string",enum:["min-content","max-content","auto"]}],description:"CSS grid track breadth"},"<inflexible-breadth>":{anyOf:[{$ref:"#/definitions/<length-percentage>"},{type:"string",enum:["min-content","max-content","auto"]}],description:"CSS inflexible breadth (track breadth without flex)"},"<track-size>":{type:"string",description:"CSS grid track size: track-breadth, minmax(), or fit-content(). Complex syntax cannot be fully validated with regex."},"<easing-function>":{anyOf:[{$ref:"#/definitions/<timing-function>"},{type:"string",pattern:"^linear\\(.*\\)$",description:"Linear easing function - arguments cannot be fully validated with regex"},{type:"string",pattern:"^steps\\(\\s*\\d+\\s*(,\\s*(start|end|jump-start|jump-end|jump-none|jump-both)\\s*)?\\)$"}],description:"CSS easing functions including cubic-bezier, steps, and linear"},"<single-animation-direction>":{type:"string",enum:["normal","reverse","alternate","alternate-reverse"],description:"CSS animation direction values"},"<single-animation-fill-mode>":{type:"string",enum:["none","forwards","backwards","both"],description:"CSS animation fill mode values"},"<single-animation-play-state>":{type:"string",enum:["running","paused"],description:"CSS animation play state values"},"<single-animation-iteration-count>":{anyOf:[{$ref:"#/definitions/<number>"},{type:"string",enum:["infinite"]}],description:"CSS animation iteration count: number or infinite"},"<keyframes-name>":{anyOf:[{$ref:"#/definitions/<custom-ident>"},{$ref:"#/definitions/<string>"}],description:"CSS keyframes name: identifier or string"},"<single-transition-property>":{anyOf:[{type:"string",enum:["all"]},{$ref:"#/definitions/<custom-ident>"}],description:"CSS transition property: all or property name"},"<quote>":{type:"string",enum:["open-quote","close-quote","no-open-quote","no-close-quote"],description:"CSS quote values for generated content"},"<counter-style-name>":{anyOf:[{$ref:"#/definitions/<custom-ident>"},{type:"string",enum:["decimal","decimal-leading-zero","lower-roman","upper-roman","lower-greek","lower-latin","upper-latin","armenian","georgian","lower-alpha","upper-alpha","disc","circle","square","none"]}],description:"CSS counter style: predefined or custom identifier"},"<ratio>":{type:"string",pattern:"^\\d+(\\.\\d+)?\\s*/\\s*\\d+(\\.\\d+)?$",description:"CSS ratio: number/number"},"<dasharray>":{type:"string",description:"CSS dash array for stroke-dasharray. Complex syntax with multiple length/percentage/number values cannot be fully validated with regex."},"<paint>":{anyOf:[{$ref:"#/definitions/<none>"},{$ref:"#/definitions/<color>"},{$ref:"#/definitions/<url>"}],description:"CSS paint values for SVG: none, color, URL, or context keywords"},"<overflow-wrap>":{type:"string",enum:["normal","break-word","anywhere"],description:"CSS overflow-wrap values (same as word-wrap)"},"<text-decoration-thickness>":{anyOf:[{$ref:"#/definitions/<auto>"},{$ref:"#/definitions/<positive-length>"},{$ref:"#/definitions/<positive-percentage>"},{type:"string",enum:["from-font"]}],description:"CSS text decoration thickness"},"<text-underline-offset>":{anyOf:[{$ref:"#/definitions/<auto>"},{$ref:"#/definitions/<length>"},{$ref:"#/definitions/<percentage>"}],description:"CSS text underline offset"},"<text-emphasis-style>":{anyOf:[{$ref:"#/definitions/<none>"},{type:"string",enum:["filled","open","dot","circle","double-circle","triangle","sesame"]},{$ref:"#/definitions/<string>"}],description:"CSS text emphasis style"},"<mask-composite>":{type:"string",enum:["add","subtract","intersect","exclude"],description:"CSS mask composite operation values"},"<mask-mode>":{type:"string",enum:["alpha","luminance","match-source"],description:"CSS mask mode values"},"<clip-path>":{anyOf:[{$ref:"#/definitions/<none>"},{$ref:"#/definitions/<url>"},{$ref:"#/definitions/<basic-shape>"}],description:"CSS clip-path: none, URL, or basic shape"},"<shape-outside>":{anyOf:[{$ref:"#/definitions/<none>"},{$ref:"#/definitions/<image>"},{$ref:"#/definitions/<basic-shape>"}