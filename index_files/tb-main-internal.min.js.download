itions/<paint>",format:"css-stroke"},{$ref:"urn:dm:schemas:css-value-definitions.schema.json#/definitions/<global-values>"}]},{maxLength:150}]},"CSS.StrokeWidth":{allOf:[{anyOf:[{$ref:"urn:dm:schemas:cssPropertySchemas.json#/definitions/CSS.LengthPercentage"},{$ref:"urn:dm:schemas:cssPropertySchemas.json#/definitions/CSS.Length"},{$ref:"urn:dm:schemas:cssPropertySchemas.json#/definitions/CSS.Percentage"},{$ref:"urn:dm:schemas:css-value-definitions.schema.json#/definitions/<var()>"},{type:"string",$ref:"urn:dm:schemas:css-value-definitions.schema.json#/definitions/<length-percentage>",format:"css-stroke-width"},{$ref:"urn:dm:schemas:css-value-definitions.schema.json#/definitions/<global-values>"}]},{maxLength:150}]},"CSS.StrokeOpacity":{allOf:[{anyOf:[{$ref:"urn:dm:schemas:cssPropertySchemas.json#/definitions/CSS.Number"},{$ref:"urn:dm:schemas:cssPropertySchemas.json#/definitions/CSS.Percentage"},{$ref:"urn:dm:schemas:css-value-definitions.schema.json#/definitions/<var()>"},{type:"string",$ref:"urn:dm:schemas:css-value-definitions.schema.json#/definitions/<alpha-value>",format:"css-stroke-opacity"},{$ref:"urn:dm:schemas:css-value-definitions.schema.json#/definitions/<global-values>"}]},{maxLength:150}]},"CSS.Display":{allOf:[{anyOf:[{$ref:"urn:dm:schemas:css-value-definitions.schema.json#/definitions/<var()>"},{type:"string",$ref:"urn:dm:schemas:css-value-definitions.schema.json#/definitions/<display>",format:"css-display"},{$ref:"urn:dm:schemas:css-value-definitions.schema.json#/definitions/<global-values>"}]},{maxLength:150}]},"CSS.Filter":{allOf:[{anyOf:[{$ref:"urn:dm:schemas:css-value-definitions.schema.json#/definitions/<var()>"},{type:"string",$ref:"urn:dm:schemas:css-value-definitions.schema.json#/definitions/<filter>",format:"css-filter"},{$ref:"urn:dm:schemas:css-value-definitions.schema.json#/definitions/<global-values>"}]},{maxLength:150}]},"CSS.WritingMode":{allOf:[{anyOf:[{$ref:"urn:dm:schemas:css-value-definitions.schema.json#/definitions/<var()>"},{type:"string",$ref:"urn:dm:schemas:css-value-definitions.schema.json#/definitions/<writing-mode>",format:"css-writing-mode"},{$ref:"urn:dm:schemas:css-value-definitions.schema.json#/definitions/<global-values>"}]},{maxLength:150}]},"CSS.MaskImage":{allOf:[{anyOf:[{$ref:"urn:dm:schemas:css-value-definitions.schema.json#/definitions/<var()>"},{type:"string",$ref:"urn:dm:schemas:css-value-definitions.schema.json#/definitions/<mask-reference>",format:"css-mask-image"},{$ref:"urn:dm:schemas:css-value-definitions.schema.json#/definitions/<global-values>"}]},{maxLength:150}]},"CSS.MaskMode":{allOf:[{anyOf:[{$ref:"urn:dm:schemas:css-value-definitions.schema.json#/definitions/<var()>"},{type:"string",$ref:"urn:dm:schemas:css-value-definitions.schema.json#/definitions/<mask-mode>",format:"css-mask-mode"},{$ref:"urn:dm:schemas:css-value-definitions.schema.json#/definitions/<global-values>"}]},{maxLength:150}]},"CSS.MaskPosition":{allOf:[{anyOf:[{$ref:"urn:dm:schemas:css-value-definitions.schema.json#/definitions/<var()>"},{type:"string",$ref:"urn:dm:schemas:css-value-definitions.schema.json#/definitions/<bg-position>",format:"css-mask-position"},{$ref:"urn:dm:schemas:css-value-definitions.schema.json#/definitions/<global-values>"}]},{maxLength:150}]},"CSS.MaskSize":{allOf:[{anyOf:[{$ref:"urn:dm:schemas:cssPropertySchemas.json#/definitions/CSS.PositiveLengthPercentage"},{$ref:"urn:dm:schemas:css-value-definitions.schema.json#/definitions/<var()>"},{type:"string",$ref:"urn:dm:schemas:css-value-definitions.schema.json#/definitions/<bg-size>",format:"css-mask-size"},{$ref:"urn:dm:schemas:css-value-definitions.schema.json#/definitions/<global-values>"}]},{maxLength:150}]},"CSS.MaskRepeat":{allOf:[{anyOf:[{$ref:"urn:dm:schemas:css-value-definitions.schema.json#/definitions/<var()>"},{type:"string",$ref:"urn:dm:schemas:css-value-definitions.schema.json#/definitions/<repeat-style>",format:"css-mask-repeat"},{$ref:"urn:dm:schemas:css-value-definitions.schema.json#/definitions/<global-values>"}]},{maxLength:150}]},"CSS.MaskOrigin":{allOf:[{anyOf:[{$ref:"urn:dm:schemas:css-value-definitions.schema.json#/definitions/<var()>"},{type:"string",$ref:"urn:dm:schemas:css-value-definitions.schema.json#/definitions/<mask-origin>",format:"css-mask-origin"},{$ref:"urn:dm:schemas:css-value-definitions.schema.json#/definitions/<global-values>"}]},{maxLength:150}]},"CSS.MaskClip":{allOf:[{anyOf:[{$ref:"urn:dm:schemas:css-value-definitions.schema.json#/definitions/<var()>"},{type:"string",$ref:"urn:dm:schemas:css-value-definitions.schema.json#/definitions/<mask-clip>",format:"css-mask-clip"},{$ref:"urn:dm:schemas:css-value-definitions.schema.json#/definitions/<global-values>"}]},{maxLength:150}]},"CSS.MaskComposite":{allOf:[{anyOf:[{$ref:"urn:dm:schemas:css-value-definitions.schema.json#/definitions/<var()>"},{type:"string",$ref:"urn:dm:schemas:css-value-definitions.schema.json#/definitions/<mask-composite>",format:"css-mask-composite"},{$ref:"urn:dm:schemas:css-value-definitions.schema.json#/definitions/<global-values>"}]},{maxLength:150}]},"CSS.Mask":{allOf:[{anyOf:[{$ref:"urn:dm:schemas:css-value-definitions.schema.json#/definitions/<var()>"},{type:"string",$ref:"urn:dm:schemas:css-value-definitions.schema.json#/definitions/<mask>",format:"css-mask"},{$ref:"urn:dm:schemas:css-value-definitions.schema.json#/definitions/<global-values>"}]},{maxLength:150}]}},ulr={$id:slr,title:llr,description:plr,definitions:clr}});var WSe={};xe(WSe,{$id:()=>dlr,default:()=>ylr,definitions:()=>glr,description:()=>flr,title:()=>mlr});var dlr,mlr,flr,glr,ylr,Bet=se(()=>{dlr="urn:dm:schemas:css-value-definitions.schema.json",mlr="CSS Value Definitions",flr="Individual JSON Schema definitions for CSS value types, suitable for format registration",glr={"<positive-value>":{type:"string",pattern:"^[^-]",description:"CSS positive value"},"<length>":{oneOf:[{$ref:"#/definitions/<basic-math-functions-without-percentage>"},{type:"string",pattern:"^(0|(-?\\d*\\.?\\d+(px|spx|em|ex|ch|rem|lh|rlh|vw|vh|vmin|vmax|cm|mm|in|pt|pc|q)))$"}],description:"CSS numeric length with all valid units"},"<positive-length>":{allOf:[{$ref:"#/definitions/<positive-value>"},{$ref:"#/definitions/<length>"}],description:"CSS positive numeric length with all valid units"},"<percentage>":{oneOf:[{$ref:"#/definitions/<basic-math-functions>"},{type:"string",pattern:"^-?\\d*\\.?\\d+%$"}],description:"Number followed by %"},"<positive-percentage>":{allOf:[{$ref:"#/definitions/<positive-value>"},{$ref:"#/definitions/<percentage>"}],description:"Positive number followed by %"},"<length-percentage>":{anyOf:[{$ref:"#/definitions/<length>"},{$ref:"#/definitions/<percentage>"}],description:"Accepts both <length> and <percentage>"},"<positive-length-percentage>":{anyOf:[{$ref:"#/definitions/<positive-length>"},{$ref:"#/definitions/<positive-percentage>"}],description:"Accepts both <positive-length> and <positive-percentage>"},"<auto>":{type:"string",enum:["auto"],description:"CSS auto keyword"},"<length-percentage-auto>":{anyOf:[{$ref:"#/definitions/<length>"},{$ref:"#/definitions/<percentage>"},{$ref:"#/definitions/<auto>"}],description:"CSS length, percentage, or auto"},"<positive-length-percentage-auto>":{anyOf:[{$ref:"#/definitions/<positive-length>"},{$ref:"#/definitions/<positive-percentage>"},{$ref:"#/definitions/<auto>"}],description:"CSS positive length, positive percentage, or auto"},"<number>":{oneOf:[{$ref:"#/definitions/<all-math-functions-without-percentage>"},{type:"string",pattern:"^-?\\d*\\.?\\d+$"}],description:"Decimal or integer number"},"<positive-number>":{allOf:[{$ref:"#/definitions/<positive-value>"},{$ref:"#/definitions/<number>"}],description:"Positive decimal or integer number"},"<integer>":{oneOf:[{$ref:"#/definitions/<all-math-functions-without-percentage>"},{type:"string",pattern:"^-?\\d+$"}],description:"Whole numbers only"},height:{anyOf:[{$ref:"#/definitions/<auto>"},{$ref:"#/definitions/<positive-length-percentage>"},{type:"string",enum:["min-content","max-content"]}],description:"CSS height value"},"<angle>":{oneOf:[{$ref:"#/definitions/<all-math-functions>"},{type:"string",pattern:"^-?\\d*\\.?\\d+(deg|rad|grad|turn)$"}],description:"Used in rotation, direction, etc."},"<time>":{oneOf:[{$ref:"#/definitions/<basic-math-functions-without-percentage>"},{type:"string",pattern:"^-?\\d*\\.?\\d+(ms|s)$"}],description:"CSS durations (s, ms)"},"<resolution>":{type:"string",pattern:"^-?\\d*\\.?\\d+(dpi|dpcm|dppx|x)$",description:"Screen density/resolution units"},"<frequency>":{oneOf:[{$ref:"#/definitions/<basic-math-functions>"},{type:"string",pattern:"^-?\\d*\\.?\\d+(Hz|kHz)$"}],description:"Used in aural CSS or media queries"},"<dimension>":{type:"string",pattern:"^-?\\d*\\.?\\d+[a-zA-Z]+$",description:"Generic dimension (unit required)"},"<percentage-or-number>":{oneOf:[{$ref:"#/definitions/<number>"},{$ref:"#/definitions/<percentage>"}],description:"Matches numbers or percentages"},"<custom-ident>":{type:"string",pattern:"^[a-zA-Z_][\\w-]*$",description:"CSS identifiers (excluding keywords)"},"<ident>":{type:"string",pattern:"^[a-zA-Z_][\\w-]*$",description:"Same as <custom-ident>"},"<string>":{type:"string",pattern:`^"(?:[^"\\\\]|\\\\.)*"|'(?:[^'\\\\]|\\\\.)*'$`,description:"Quoted strings with escapes"},"<url>":{type:"string",pattern:`^url\\((['"]?).*?\\1\\)$`,description:"Matches url(...) with optional quotes"},"<hex-color>":{type:"string",pattern:"^#([a-fA-F0-9]{3}|[a-fA-F0-9]{4}|[a-fA-F0-9]{6}|[a-fA-F0-9]{8})$",description:"Hexadecimal color values: #rgb, #rgba, #rrggbb, #rrggbbaa"},"<rgb-color>":{type:"string",pattern:"^rgba?\\(\\s*\\d+\\s*,\\s*\\d+\\s*,\\s*\\d+(\\s*,\\s*\\d*(\\.\\d+)?)?\\s*\\)$",description:"RGB/RGBA functional notation. Note: This regex cannot fully validate percentage values or modern space-separated syntax."},"<hsl-color>":{type:"string",pattern:"^hsla?\\(\\s*\\d+\\s*,\\s*\\d+%\\s*,\\s*\\d+%(\\s*,\\s*\\d*(\\.\\d+)?)?\\s*\\)$",description:"HSL/HSLA functional notation. Note: This regex cannot fully validate modern space-separated syntax or angle units for hue."},"<named-color>":{type:"string",enum:["transparent","currentColor","aliceblue","antiquewhite","aqua","aquamarine","azure","beige","bisque","black","blanchedalmond","blue","blueviolet","brown","burlywood","cadetblue","chartreuse","chocolate","coral","cornflowerblue","cornsilk","crimson","cyan","darkblue","darkcyan","darkgoldenrod","darkgray","darkgrey","darkgreen","darkkhaki","darkmagenta","darkolivegreen","darkorange","darkorchid","darkred","darksalmon","darkseagreen","darkslateblue","darkslategray","darkslategrey","darkturquoise","darkviolet","deeppink","deepskyblue","dimgray","dimgrey","dodgerblue","firebrick","floralwhite","forestgreen","fuchsia","gainsboro","ghostwhite","gold","goldenrod","gray","grey","green","greenyellow","honeydew","hotpink","indianred","indigo","ivory","khaki","lavender","lavenderblush","lawngreen","lemonchiffon","lightblue","lightcoral","lightcyan","lightgoldenrodyellow","lightgray","lightgrey","lightgreen","lightpink","lightsalmon","lightseagreen","lightskyblue","lightslategray","lightslategrey","lightsteelblue","lightyellow","lime","limegreen","linen","magenta","maroon","mediumaquamarine","mediumblue","mediumorchid","mediumpurple","mediumseagreen","mediumslateblue","mediumspringgreen","mediumturquoise","mediumvioletred","midnightblue","mintcream","mistyrose","moccasin","navajowhite","navy","oldlace","olive","olivedrab","orange","orangered","orchid","palegoldenrod","palegreen","paleturquoise","palevioletred","papayawhip","peachpuff","peru","pink","plum","powderblue","purple","rebeccapurple","red","rosybrown","royalblue","saddlebrown","salmon","sandybrown","seagreen","seashell","sienna","silver","skyblue","slateblue","slategray","slategrey","snow","springgreen","steelblue","tan","teal","thistle","tomato","turquoise","violet","wheat","white","whitesmoke","yellow","yellowgreen"],description:"CSS named colors including transparent and currentColor"},"<css-value-containing-var()>":{type:"string",pattern:"^(?=.*var\\(\\s*--[^)]).+$",description:"Any CSS value string containing at least one var() reference. Slot-level validation is deferred to runtime (dummy substitution / css-tree)."},"<color>":{anyOf:[{$ref:"#/definitions/<hex-color>"},{$ref:"#/definitions/<rgb-color>"},{$ref:"#/definitions/<hsl-color>"},{$ref:"#/definitions/<named-color>"}],description:"CSS color values supporting hex, rgb/rgba, hsl/hsla, and named colors"},"<image>":{anyOf:[{$ref:"#/definitions/<url>"},{type:"string",pattern:"^(linear-gradient|radial-gradient|conic-gradient|repeating-linear-gradient|repeating-radial-gradient|repeating-conic-gradient)\\(.*\\)$",description:"Gradient functions - arguments cannot be fully validated with regex"},{type:"string",pattern:"^image\\(.*\\)$",description:"Image function - arguments cannot be fully validated with regex"}],description:"CSS image values including URLs, gradients, and image() functions"},"<position>":{anyOf:[{$ref:"#/definitions/<position-one>"},{$ref:"#/definitions/<position-two>"},{$ref:"#/definitions/<position-four>"}],description:"Single position value. Full position syntax with multiple values and combinations requires complex parsing that cannot be fully validated with regex."},"<position-one>":{anyOf:[{enum:["left","center","right","top","bottom","x-start","x-end","y-start","y-end","block-start","block-end","inline-start","inline-end"]},{$ref:"#/definitions/<positive-length-percentage>"}]},"<position-two>":{anyOf:[{pattern:"^(((left|center|right|x-start|x-end)\\s(top|center|bottom|y-start|y-end))|((top|center|bottom|y-start|y-end)\\s(left|center|right|x-start|x-end)))$"},{pattern:"^(0|(calc|min|max|clamp|round|mod|rem|abs)\\(.+\\)|\\d+(\\.\\d+)?(px|spx|em|ex|ch|rem|lh|rlh|vw|vh|vmin|vmax|cm|mm|in|pt|pc|q|%))\\s(0|(calc|min|max|clamp|round|mod|rem|abs)\\(.+\\)|\\d+(\\.\\d+)?(px|spx|em|ex|ch|rem|lh|rlh|vw|vh|vmin|vmax|cm|mm|in|pt|pc|q|%))$"},{pattern:"^((block-start|center|block-end)\\s(inline-start|center|inline-end))|((inline-start|center|inline-end)\\s(block-start|center|block-end))$"},{pattern:"^((start|center|end)\\s*){2}$"}]},"<position-four>":{anyOf:[{pattern:"^((left|right|x-start|x-end)\\s(0|(calc|min|max|clamp|round|mod|rem|abs)\\(.+\\)|\\d+(\\.\\d+)?(px|spx|em|ex|ch|rem|lh|rlh|vw|vh|vmin|vmax|cm|mm|in|pt|pc|q|%))\\s(top|bottom|y-start|y-end)\\s(0|(calc|min|max|clamp|round|mod|rem|abs)\\(.+\\)|\\d+(\\.\\d+)?(px|spx|em|ex|ch|rem|lh|rlh|vw|vh|vmin|vmax|cm|mm|in|pt|pc|q|%)))|((top|bottom|y-start|y-end)\\s(0|(calc|min|max|clamp|round|mod|rem|abs)\\(.+\\)|\\d+(\\.\\d+)?(px|spx|em|ex|ch|rem|lh|rlh|vw|vh|vmin|vmax|cm|mm|in|pt|pc|q|%))\\s(left|right|x-start|x-end)\\s(0|(calc|min|max|clamp|round|mod|rem|abs)\\(.+\\)|\\d+(\\.\\d+)?(px|spx|em|ex|ch|rem|lh|rlh|vw|vh|vmin|vmax|cm|mm|in|pt|pc|q|%)))$"},{pattern:"^((block-start|block-end)\\s(0|(calc|min|max|clamp|round|mod|rem|abs)\\(.+\\)|\\d+(\\.\\d+)?(px|spx|em|ex|ch|rem|lh|rlh|vw|vh|vmin|vmax|cm|mm|in|pt|pc|q|%))\\s(inline-start|inline-end)\\s(0|(calc|min|max|clamp|round|mod|rem|abs)\\(.+\\)|\\d+(\\.\\d+)?(px|spx|em|ex|ch|rem|lh|rlh|vw|vh|vmin|vmax|cm|mm|in|pt|pc|q|%)))|((inline-start|inline-end)\\s(0|(calc|min|max|clamp|round|mod|rem|abs)\\(.+\\)|\\d+(\\.\\d+)?(px|spx|em|ex|ch|rem|lh|rlh|vw|vh|vmin|vmax|cm|mm|in|pt|pc|q|%))\\s(block-start|block-end)\\s(0|(calc|min|max|clamp|round|mod|rem|abs)\\(.+\\)|\\d+(\\.\\d+)?(px|spx|em|ex|ch|rem|lh|rlh|vw|vh|vmin|vmax|cm|mm|in|pt|pc|q|%)))$"},{pattern:"^((start|end)\\s(0|(calc|min|max|clamp|round|mod|rem|abs)\\(.+\\)|\\d+(\\.\\d+)?(px|spx|em|ex|ch|rem|lh|rlh|vw|vh|vmin|vmax|cm|mm|in|pt|pc|q|%))\\s*){2}$"}]},"<transform-function>":{type:"string",pattern:"^(matrix|matrix3d|perspective|rotate|rotate3d|rotateX|rotateY|rotateZ|scale|scale3d|scaleX|scaleY|scaleZ|skew|skewX|skewY|translate|translate3d|translateX|translateY|translateZ)\\(.*\\)$",description:"Transform functions like rotate(), translate(), scale(). Function arguments cannot be fully validated with regex as they require parsing of nested expressions."},"<var()>":{type:"string",pattern:"^var\\(--[^(),]+(?:,\\s?.+)?\\)$",description:"CSS var() function- resolving a variable value from the variable"},"<basic-math-functions>":{type:"string",pattern:"^(calc|min|max|clamp|round|mod|rem|abs)\\((?!.*\\/\\s*0\\b).+\\)$",description:"Basic CSS math functions that work with any value type. Percentages allowed where contextually appropriate."},"<basic-math-functions-without-percentage>":{type:"string",pattern:"^(calc|min|max|clamp|round|mod|rem|abs)\\((?!.*\\/\\s*0\\b)[^%]+\\)$",description:"Basic CSS math functions without percentages or division by zero."},"<basic-math-functions-with-percentage>":{type:"string",pattern:"(calc|min|max|clamp|round|mod|rem|abs)\\([^)]*%[^)]*\\)",description:"Detects if any basic math function contains percentages"},"<all-math-functions>":{type:"string",pattern:"^(calc|min|max|clamp|round|mod|rem|abs|sin|cos|tan|asin|acos|atan|atan2|pow|sqrt|hypot|log|exp|sign)\\((?!.*\\/\\s*0\\b).+\\)$",description:"All CSS math functions - basic, trigonometric, and advanced mathematical functions."},"<all-math-functions-without-percentage>":{type:"string",pattern:"^(calc|min|max|clamp|round|mod|rem|abs|sin|cos|tan|asin|acos|atan|atan2|pow|sqrt|hypot|log|exp|sign)\\((?!.*\\/\\s*0\\b)(?!.*%).+\\)$",description:"All CSS math functions without percentages or division by zero."},"<attr()>":{type:"string",pattern:"^attr\\(.*\\)$",description:"CSS attr() function. Cannot fully validate fallback values and type hints with regex."},"<image-set()>":{type:"string",pattern:"^image-set\\(.*\\)$",description:"CSS image-set() function. Cannot parse comma-separated URLs and resolution descriptors with regex."},"<basic-shape>":{type:"string",pattern:"^(inset|rect|xywh|circle|ellipse|polygon|path|shape)\\(.*\\)$",description:"CSS basic shape functions. Shape-specific arguments cannot be fully validated with regex."},"<filter-function>":{type:"string",pattern:"^(blur|brightness|contrast|drop-shadow|grayscale|hue-rotate|invert|opacity|saturate|sepia|url)\\(([^\\(\\)]*|(\\([^\\(\\)]*\\)))+\\)$",description:"CSS filter functions. Function arguments cannot be fully validated with regex."},"<filter-value-list>":{type:"string",pattern:"^((blur|brightness|contrast|drop-shadow|grayscale|hue-rotate|invert|opacity|saturate|sepia|url)\\(([^\\(\\)]*|(\\([^\\(\\)]*\\)))+\\))(\\s+(blur|brightness|contrast|drop-shadow|grayscale|hue-rotate|invert|opacity|saturate|sepia|url)\\(([^\\(\\)]*|(\\([^\\(\\)]*\\)))+\\))*$",description:"CSS filter functions - value separated list. Function arguments cannot be fully validated with regex."},"<filter>":{anyOf:[{$ref:"#/definitions/<none>"},{$ref:"#/definitions/<filter-value-list>"}],description:"CSS filter value"},"<line-width>":{anyOf:[{$ref:"#/definitions/<positive-length>"},{type:"string",enum:["thin","medium","thick"]}],description:"CSS line width: length values or predefined keywords"},"<line-style>":{type:"string",enum:["none","hidden","dotted","dashed","solid","double","groove","ridge","inset","outset"],description:"CSS line style keywords"},"<global-values>":{type:"string",enum:["inherit","initial","unset","revert","revert-layer"],description:"Global values available for any CSS property"},"<flex>":{type:"string",pattern:"^\\d*\\.?\\d+fr$",description:"CSS flex unit for grid and flexbox"},"<none>":{type:"string",enum:["none"],description:"CSS none keyword"},"<normal>":{type:"string",enum:["normal"],description:"CSS normal keyword"},"<shadow>":{anyOf:[{$ref:"#/definitions/<none>"},{type:"string",pattern:"^(inset\\s+)?(-?\\d+\\w*\\s+){2,4}(#[a-fA-F0-9]{3,8}|rgba?\\(.*\\)|hsla?\\(.*\\)|[a-zA-Z]+)?$"}],description:"CSS shadow value (box-shadow, text-shadow). Complex syntax with optional inset, multiple length values, and color cannot be fully validated with regex."},"<font-family>":{anyOf:[{$ref:"#/definitions/<family-name>"},{$ref:"#/definitions/<generic-family>"},{type:"string",pattern:`^['"]?([^\\d][\\p{L}\\s\\-_\\d]*)['"]?(,\\s*['"]