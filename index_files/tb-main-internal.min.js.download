t","Scrollbar","ThreeDDarkShadow","ThreeDFace","ThreeDHighlight","ThreeDLightShadow","ThreeDShadow","Window","WindowFrame","WindowText"],description:"CSS deprecated system colors"},"<bg-size>":{anyOf:[{$ref:"#/definitions/<positive-length-percentage>"},{type:"string",enum:["auto","cover","contain"]},{type:"string",pattern:"^(auto|calc|min|max|clamp|round|mod|rem|abs\\([^,]+\\)|\\d*\\.?\\d+(px|spx|em|ex|ch|rem|lh|rlh|vw|vh|vmin|vmax|cm|mm|in|pt|pc|q|%))(\\s+(auto|calc|min|max|clamp|round|mod|rem|abs\\([^,]+\\)|\\d*\\.?\\d+(px|spx|em|ex|ch|rem|lh|rlh|vw|vh|vmin|vmax|cm|mm|in|pt|pc|q|%))?)$",description:"complex syntax with multiple values that cannot be fully validated with regex"}],description:"CSS background-size values"},"<bg-position>":{type:"string",description:"CSS background-position values. Complex syntax with multiple position values and combinations cannot be fully validated with regex."},"<bg-clip>":{anyOf:[{$ref:"#/definitions/<visual-box>"},{type:"string",enum:["text"]}],description:"CSS background-clip values"},"<bg-image>":{anyOf:[{$ref:"#/definitions/<none>"},{$ref:"#/definitions/<image>"}],description:"CSS background-image values"},"<hue>":{anyOf:[{$ref:"#/definitions/<number>"},{$ref:"#/definitions/<angle>"}],description:"CSS hue value: number or angle"},"<radial-shape>":{type:"string",enum:["circle","ellipse"],description:"CSS radial gradient shape"},"<radial-extent>":{type:"string",enum:["closest-corner","closest-side","farthest-corner","farthest-side"],description:"CSS radial gradient extent"},"<side-or-corner>":{type:"string",pattern:"^(left|right|top|bottom)$|^(left|right)\\s+(top|bottom)$|^(top|bottom)\\s+(left|right)$",description:"CSS gradient side or corner direction"},"<color-stop-length>":{anyOf:[{$ref:"#/definitions/<length-percentage>"},{type:"string",pattern:"^\\d+(\\.\\d+)?%\\s+\\d+(\\.\\d+)?%$"}],description:"CSS color stop length: single or double length-percentage"},"<color-stop-angle>":{anyOf:[{$ref:"#/definitions/<angle-percentage