ne"},{type:"string",pattern:"^(underline|overline|line-through|blink)(\\s+(underline|overline|line-through|blink))*$",description:"multiple values text decoration line that cannot be fully validated with regex"}],description:"CSS text-decoration-line values"},"<text-decoration-style>":{type:"string",enum:["solid","double","dotted","dashed","wavy"],description:"CSS text-decoration-style values"},"<text-transform>":{type:"string",enum:["none","capitalize","uppercase","lowercase","full-width","full-size-kana"],description:"CSS text-transform values"},"<word-wrap>":{type:"string",enum:["normal","break-word","anywhere"],description:"CSS word-wrap/overflow-wrap values"},"<user-select>":{type:"string",enum:["auto","text","none","contain","all"],description:"CSS user-select values"},"<pointer-events>":{type:"string",enum:["auto","bounding-box","none","visiblePainted","visibleFill","visibleStroke","visible","painted","fill","stroke","all"],description:"CSS pointer-events values"},"<box-sizing>":{type:"string",enum:["content-box","border-box"],description:"CSS box-sizing values"},"<resize>":{type:"string",enum:["none","both","horizontal","vertical","block","inline"],description:"CSS resize values"},"<outline>":{type:"string",description:"CSS outline shorthand. Complex syntax combining outline-width, outline-style, and outline-color cannot be fully validated with regex."},"<quotes>":{anyOf:[{type:"string",enum:["none","auto"]},{$ref:"#/definitions/<string>"}],description:"CSS quotes: none, auto, or quoted string pairs"},"<content>":{type:"string",description:"CSS content property. Complex syntax with strings, counters, attr(), and url() cannot be fully validated with regex."},"<will-change>":{anyOf:[{$ref:"#/definitions/<auto>"},{type:"string",enum:["scroll-position","contents"]},{$ref:"#/definitions/<custom-ident>"}],description:"CSS will-change: auto or property names"},"<contain>":{type:"string",enum:["none","strict","content","size","inline-size","layout","style","paint"],