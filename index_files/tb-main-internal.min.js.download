finitions/<image>"},{$ref:"#/definitions/<custom-ident>"}],description:"CSS symbol values for counters"},"<symbols-type>":{type:"string",enum:["cyclic","numeric","alphabetic","symbolic","fixed"],description:"CSS symbols() function type"},"<feature-tag-value>":{type:"string",description:"CSS font feature tag value. Complex syntax with string and optional integer/keyword cannot be fully validated with regex."},"<east-asian-variant-values>":{type:"string",enum:["jis78","jis83","jis90","jis04","simplified","traditional"],description:"CSS East Asian variant values"},"<east-asian-width-values>":{type:"string",enum:["full-width","proportional-width"],description:"CSS East Asian width values"},"<numeric-figure-values>":{type:"string",enum:["lining-nums","oldstyle-nums"],description:"CSS numeric figure values"},"<numeric-fraction-values>":{type:"string",enum:["diagonal-fractions","stacked-fractions"],description:"CSS numeric fraction values"},"<numeric-spacing-values>":{type:"string",enum:["proportional-nums","tabular-nums"],description:"CSS numeric spacing values"},"<common-lig-values>":{type:"string",enum:["common-ligatures","no-common-ligatures"],description:"CSS common ligature values"},"<discretionary-lig-values>":{type:"string",enum:["discretionary-ligatures","no-discretionary-ligatures"],description:"CSS discretionary ligature values"},"<historical-lig-values>":{type:"string",enum:["historical-ligatures","no-historical-ligatures"],description:"CSS historical ligature values"},"<contextual-alt-values>":{type:"string",enum:["contextual","no-contextual"],description:"CSS contextual alternates values"},"<composite-style>":{type:"string",enum:["clear","copy","source-over","source-in","source-out","source-atop","destination-over","destination-in","destination-out","destination-atop","xor"],description:"CSS composite style values"},"<compositing-operator>":{type:"string",enum:["add","subtract","intersect","exclude"],description:"CSS compositing operator values"},"<axis>":{ty